# RyouU Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Rename this file to .env and fill in your real values.
# The .env file is loaded automatically by both detectifai_verifier.py and
# supabase_gateway.py via python-dotenv.
#
# None of these values are required for local debug mode — the app will fall
# back to the debug_audio/ folder automatically when Supabase is not configured.
# ─────────────────────────────────────────────────────────────────────────────

# ── Detectif.ai API ──────────────────────────────────────────────────────────
# Obtain your key from: https://platform.detectif.ai/dashboard/keys/
# Format: dtf_live_...
# Official env var: DETECTIF_API_KEY (also supports DETECTIFAI_API_KEY)
DETECTIF_API_KEY=
# DETECTIFAI_API_KEY=

# Override the Detectif.ai API base URL if needed.
# Default: https://platform.detectif.ai/v1
# DETECTIF_API_URL=https://platform.detectif.ai/v1

# ── Supabase ─────────────────────────────────────────────────────────────────
# Your Supabase project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=

# Supabase anon key (safe for server-side usage, never expose in the browser)
SUPABASE_KEY=

# Name of the Supabase Storage bucket holding candidate reference audio files.
# Each file should be named <candidate_id>.wav (e.g. candidate-001.wav)
SUPABASE_BUCKET=kyc-reference-audio

# Name of the Supabase database table that stores candidate records.
# The table should have a `candidate_id` column, and optionally a
# `reference_audio_url` / `audio_path` column pointing to the storage path.
SUPABASE_TABLE=candidates
